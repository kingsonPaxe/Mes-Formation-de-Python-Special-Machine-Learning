   "source": [
    "# Exercicies\n",
    "\n",
    "Lire 'ficher.txt' et retourner une list [' 0^2 = 0', ' 1^2 = 1', ..., ' 9^2 = 81']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "[\"[' 0^2 = 0', ' 1^2 = 1', ' 2^2 = 4', ' 3^2 = 9', ' 4^2 = 16', ' 5^2 = 25', ' 6^2 = 36', ' 7^2 = 49', ' 8^2 = 64', ' 9^2 = 81']\"]"
      ]
     },
     "execution_count": 14,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "liste = [arch.strip() for arch in open(r'ficher.txt')]\n",
    "liste"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [
